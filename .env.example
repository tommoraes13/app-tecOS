# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Valores em: Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave usada para criptografar as senhas dos equipamentos (AES-256, 32 bytes em base64).
# Gere com: openssl rand -base64 32
# Guarde uma cópia em local seguro: sem ela, as senhas salvas não podem ser lidas.
EQUIPMENT_SECRET_KEY=
